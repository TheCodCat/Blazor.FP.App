@page "/change/{request:int}"
@using Radzen
@rendermode InteractiveServer
@using Blazor.FP.BL.dtos
@using MediatR
@inject IMediator mediator

<RadzenStack JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center">
    <RadzenCard>
    <RadzenFieldset Text="Новый пароль">
        <RadzenTemplateForm TItem="ChangeModel" Data="@changeModel" Submit="@ChangePass">


            <RadzenRow>

                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenLabel Text="Логин"/>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="9">
                    <RadzenTextBox Disabled="true" Value="@(dto?.Login ?? string.Empty)" Style="display: block; width: 100%"/>
                </RadzenColumn>


                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenLabel Text="Пароль"/>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="9">
                    <RadzenPassword  Placeholder="Пароль" Name="Password" @bind-Value="@changeModel.Password" Style="display: block; width: 100%"/>
                    <RadzenRequiredValidator Text="Пароль должен быть заполнен" Component="Password" Popup="true" Style="position: absolute"/>
                    <RadzenLengthValidator Min="7" Max="20" Text="Пароль от 7 до 20 символов" Component="Password" Popup="true" Style="position: absolute" />
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="3">
                    <RadzenLabel Text="Подтвердить пароль пароль" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="9">
                        <RadzenPassword Placeholder="Подтвердить пароль пароль" Name="ConfirmPassword" @bind-Value="@changeModel.ConfirmPassword" Style="display: block; width: 100%" />
                    <RadzenRequiredValidator Text="Пароль должен быть заполнен" Component="ConfirmPassword" Popup="true" Style="position: absolute" />
                    <RadzenCompareValidator Popup="true" Component="ConfirmPassword" Value="@changeModel.Password" Text="Пароль должен совпадать" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenButton Disabled="@isBusy" IsBusy="@isBusy" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" Text="Сбросить пароль" />
        </RadzenTemplateForm>
    </RadzenFieldset>
    </RadzenCard>
</RadzenStack>

@code{
    [Parameter] public int request { get; set; }
    private ForgotPasswordRequestDto dto { get; set; }
    private bool isBusy;

    class ChangeModel
    {
        public string Password { get; set; }
        public string ConfirmPassword { get; set; }
    }

    private ChangeModel changeModel = new ChangeModel();

    private async Task ChangePass()
    {
        isBusy = true;

        var request = new BL.request.ChangePasswordRequest(dto);

        var responce = await mediator.Send(request);

        isBusy = false;
    }

    protected override async Task OnInitializedAsync()
    {
        var reques = new BL.request.GetForgotPasswordRequest(request);

        var result = await mediator.Send(reques);
        if (result.IsSuccess)
            dto = result.Value;
    }
}